{
  "name": "topicos-harness-fds",
  "version": "0.1.0",
  "description": "Coding agent de terminal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSolizDuran/topico_harness.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "link": "npm run build && npm link",
    "prepack": "npm run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "bin": {
    "harness": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.3.0",
    "react-devtools-core": "^6.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
